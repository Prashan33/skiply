{"_id":"video.WKfPctdIDek","_type":"video","id":"WKfPctdIDek","url":"https://www.youtube.com/watch?v=WKfPctdIDek","chapters":[{"_key":"ch0","_type":"chapter","startSeconds":0,"label":"Introduction"},{"_key":"ch1","_type":"chapter","startSeconds":45,"label":"Fetching data in Server Components"},{"_key":"ch2","_type":"chapter","startSeconds":210,"label":"Async and await on the server"},{"_key":"ch3","_type":"chapter","startSeconds":360,"label":"Caching and deduping fetch requests"},{"_key":"ch4","_type":"chapter","startSeconds":520,"label":"Streaming with Suspense"}],"chunks":[{"_key":"c0","_type":"chunk","startSeconds":48,"text":"In a server component you fetch data directly with async and await, with no useEffect and no client round trip."},{"_key":"c1","_type":"chunk","startSeconds":365,"text":"Next dedupes identical fetch calls and caches the result so repeated data fetching stays cheap."}]}
