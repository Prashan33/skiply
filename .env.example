# ---------------------------------------------------------------------------
# Canonical list of environment variables for the Skiply web app (repo root).
# Copy to .env.local and fill in. The standalone Studio has its own
# studio/.env.example.
# ---------------------------------------------------------------------------

# Sanity — client-safe (inlined into the browser bundle)
NEXT_PUBLIC_SANITY_PROJECT_ID="g178ibto"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-08-29"

# Sanity — SERVER ONLY. Viewer token for the private dataset.
# Create at https://www.sanity.io/manage/project/g178ibto/api
# Also used as the Bearer token for the Sanity Context MCP.
SANITY_API_READ_TOKEN=

# Sanity — SERVER ONLY. Editor token used only by POST /api/progress to write
# learner progress documents (AGENTS.md §5/§12). Never exposed to the browser.
SANITY_API_WRITE_TOKEN=

# Optional, SERVER ONLY. Overrides the 7-minute (420s) watch threshold for
# lesson completion — handy for QA (e.g. 20). 90%-for-short-videos still applies.
# PROGRESS_COMPLETE_SECONDS=420

# Search (AGENTS.md §5/§10/§12) — SERVER ONLY.
# Base Context MCP URL. After deploying the Studio and importing
# studio/scripts/seed/agent-context.ndjson, append the config-doc slug:
#   .../context/mcp/g178ibto/production/vertex-search
SANITY_CONTEXT_MCP_URL="https://api.sanity.io/v2026-03-03/context/mcp/g178ibto/production"

# OpenAI key for the search agent (Vercel AI SDK). SERVER ONLY.
OPENAI_API_KEY=
# Optional model override. Default gpt-4.1-mini (fast, well under a 30k TPM cap).
# OPENAI_SEARCH_MODEL=gpt-4.1-mini

# Clerk — publishable key is client-safe, secret key is SERVER ONLY
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
